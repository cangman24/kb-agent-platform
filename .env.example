# ---------------------------------------------------------------------------
# 环境变量模板 —— 复制成 .env 后填写真实值
#
#   cp .env.example .env
#
# ★ .env 已在 .gitignore 中，**绝不要**把填好的 .env 提交上去。
#   CI 里有一条 secret-guard 会扫描**全部历史**，提交过就永久留在 git 里了。
#
# ★ 不填 Key 也能跑：离线 demo 与 `python -m kb_agent.cli --offline`
#   都不需要任何 Key，Agent 的编排与管控逻辑可以零成本验证。
# ---------------------------------------------------------------------------

# ------------------------------------------------------------------ 必填（仅真机）
# DeepSeek API Key。用 OpenAI 兼容协议调用 function calling。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------ 内置知识库
# 内置语料目录（.md + tickets.json + metrics.json），走 BM25，无需嵌入模型
KB_DIR=data/kb
KB_CHUNK_SIZE=256

# ------------------------------------------------------------------ 检索与工具
KB_TOP_K=3

# ------------------------------------------------------------------ 管控参数
# ★ 这两个是安全边界，不是性能参数：
#   max_rounds     —— 最多几轮（防死循环）
#   max_tool_calls —— 最多调几次工具（防失控 + 控成本）
#   调小会让长任务被误熔断，调大会让失控成本变高，按业务权衡。
KB_MAX_ROUNDS=6
KB_MAX_TOOL_CALLS=12

# ------------------------------------------------------------------ 服务
KB_HOST=127.0.0.1
KB_PORT=8000
